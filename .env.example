# Configuration names for this project. Never commit real values.
#
# Legacy PHP app: PHP reads real environment variables via getenv(), not this
# file. Set them in the web server, quoting the DSN because it contains ';':
#   Apache:  SetEnv RR_DB_DSN "mysql:host=localhost;dbname=ricochet_robots;charset=utf8"
#   PHP-FPM: env[RR_DB_DSN] = "mysql:host=localhost;dbname=ricochet_robots;charset=utf8"
#            (in the pool config; with the default clear_env=yes only env[]
#            entries reach PHP)
# For the Rust server (later phases) copy this file to .env, which is git-ignored.

RR_DB_DSN="mysql:host=localhost;dbname=ricochet_robots;charset=utf8"
RR_DB_USER=
RR_DB_PASSWORD=
