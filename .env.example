# Configuration names for this project. Never commit real values.
#
# Legacy PHP app: PHP reads real environment variables via getenv(), not this
# file. Set them in the web server, quoting the DSN because it contains ';':
#   Apache:  SetEnv RR_DB_DSN "mysql:host=localhost;dbname=ricochet_robots;charset=utf8"
#   PHP-FPM: env[RR_DB_DSN] = "mysql:host=localhost;dbname=ricochet_robots;charset=utf8"
#            (in the pool config; with the default clear_env=yes only env[]
#            entries reach PHP)
# Copy this file to .env (git-ignored) for the Rust server (later phases) and
# to source it into your shell for the legacy CLI scripts (see README).
# Single-quote values containing $, backticks or spaces so sourcing works;
# write a literal ' inside a single-quoted value as '\''.

RR_DB_DSN="mysql:host=localhost;dbname=ricochet_robots;charset=utf8"
RR_DB_USER=
RR_DB_PASSWORD=

# Rust server (crates/server). All optional for local development.
RR_BIND=127.0.0.1:8080
RR_DATABASE_URL=sqlite://ricochet.db
RR_PUBLIC_BASE_URL=http://localhost:8080
# RR_GUEST_STARTS: guest starts allowed per client (IPv4 address or IPv6
# /64) within the window. RR_GUEST_WINDOW_SECS: window length in seconds.
RR_GUEST_STARTS=5
RR_GUEST_WINDOW_SECS=600
# Per-client limits key on the connecting address (IPv4, or IPv6 /64). Until
# trusted proxy support lands, don't run the server behind a reverse proxy:
# every player would share the proxy's limits (the socket cap bites first).
#
# Rooms: RR_ROOMS_MAX open rooms in total; RR_ROOMS_PER_OWNER open rooms per
# player and, separately, per client; RR_ROOM_CAPACITY players per room;
# RR_ROOM_CREATES room creations per client within RR_ROOM_CREATE_WINDOW_SECS.
RR_ROOMS_MAX=200
RR_ROOMS_PER_OWNER=2
RR_ROOM_CAPACITY=8
RR_ROOM_CREATES=5
RR_ROOM_CREATE_WINDOW_SECS=600
# In-game limits per player: RR_CHAT_PER_SEC chat messages and
# RR_ACTIONS_PER_SEC other game messages (bids, moves, start, concede,
# malformed ones) per second.
RR_CHAT_PER_SEC=1
RR_ACTIONS_PER_SEC=10
# Open game sockets: RR_SOCKETS_PER_PLAYER per player and
# RR_SOCKETS_PER_CLIENT per client (IPv4 address or IPv6 /64).
RR_SOCKETS_PER_PLAYER=4
RR_SOCKETS_PER_CLIENT=32
